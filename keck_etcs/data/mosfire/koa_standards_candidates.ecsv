# meta: !!omap
# - {description: 'KOA census of public MOSFIRE long-slit and long2pos standard-star observations in J, J2, J3, Y, H, K (design 4.1, D50;
#     plan S14, S23c); one table per instrument, all bands, the band in the filter column'}
# - {instrument: keck_mosfire}
# - filters: [J, J2, J3, Y, H, K]
# - filter_groups:
#     H: [H]
#     J: [J, J2, J3]
#     K: [K]
#     Y: [Y]
# - koa_queries: {H: 'SELECT koaid, date_obs, ut, mjd_obs, targname, object, ra, dec, maskname, filter, gratmode, obsmode, sampmode, numreads,
#       truitime, airmass, pattern, frameid, yoffset, progid, progpi, koaimtyp, propint, semid, axestat, domestat, flatspec, pwstata7,
#       pwstata8, pwloca7, pwloca8 FROM koa_mosfire WHERE gratmode = ''spectroscopy'' AND filter IN (''H'') AND (maskname LIKE ''LONGSLIT%''
#       OR maskname LIKE ''long2pos%'')', J: 'SELECT koaid, date_obs, ut, mjd_obs, targname, object, ra, dec, maskname, filter, gratmode,
#       obsmode, sampmode, numreads, truitime, airmass, pattern, frameid, yoffset, progid, progpi, koaimtyp, propint, semid, axestat,
#       domestat, flatspec, pwstata7, pwstata8, pwloca7, pwloca8 FROM koa_mosfire WHERE gratmode = ''spectroscopy'' AND filter IN (''J'',
#       ''J2'', ''J3'') AND (maskname LIKE ''LONGSLIT%'' OR maskname LIKE ''long2pos%'')', K: 'SELECT koaid, date_obs, ut, mjd_obs, targname,
#       object, ra, dec, maskname, filter, gratmode, obsmode, sampmode, numreads, truitime, airmass, pattern, frameid, yoffset, progid,
#       progpi, koaimtyp, propint, semid, axestat, domestat, flatspec, pwstata7, pwstata8, pwloca7, pwloca8 FROM koa_mosfire WHERE gratmode
#       = ''spectroscopy'' AND filter IN (''K'') AND (maskname LIKE ''LONGSLIT%'' OR maskname LIKE ''long2pos%'')', Y: 'SELECT koaid,
#       date_obs, ut, mjd_obs, targname, object, ra, dec, maskname, filter, gratmode, obsmode, sampmode, numreads, truitime, airmass,
#       pattern, frameid, yoffset, progid, progpi, koaimtyp, propint, semid, axestat, domestat, flatspec, pwstata7, pwstata8, pwloca7,
#       pwloca8 FROM koa_mosfire WHERE gratmode = ''spectroscopy'' AND filter IN (''Y'') AND (maskname LIKE ''LONGSLIT%'' OR maskname
#       LIKE ''long2pos%'')'}
# - koa_rows: {H: 15409, J: 12769, K: 27575, Y: 11317}
# - {koa_rows_total: 67070}
# - {public_only: KOA TAP returns public frames only}
# - archives: [xshooter, calspec, esofil, noao, ing, lbtmods, blackbody]
# - {match_arcsec: 60.0}
# - {wide_slit_arcsec: 3.0}
# - {a0v_source: 'SIMBAD sp_type A0* V<11, dwarfs/unclassified'}
# - {tmass: 'VizieR II/246, 5" cone, J/H/Ks'}
